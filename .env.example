# Server
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# Database
DATABASE_URL=postgres://user:password@localhost:5432/rsvp

# Event configuration
EVENT_NAME=Annual Celebration Gala
EVENT_DESCRIPTION=Join us for an unforgettable evening.
EVENT_DATE=2025-12-31T18:00:00Z
EVENT_VENUE=The Grand Ballroom, 123 Main St
EVENT_TIMEZONE=America/New_York

# Initial admin (used only by seed-admin script)
ADMIN_EMAIL=admin@booking-kiosk.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrator

# GoDaddy SMTP
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@booking-kiosk.com
SMTP_PASS=your-smtp-password
EMAIL_FROM=you@booking-kiosk.com
EMAIL_FROM_NAME=Booking Kiosk Events